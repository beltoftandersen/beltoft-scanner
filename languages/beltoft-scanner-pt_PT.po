#. Plugin Name of the plugin
#: beltoft-scanner.php
msgid "Beltoft Scanner"
msgstr ""

#. Description of the plugin
#: beltoft-scanner.php
msgid "Scan product barcodes with the phone camera into the WooCommerce cart, on the pages other plugins register it for."
msgstr "Leia códigos de barras de produtos com a câmara do telemóvel diretamente para o carrinho WooCommerce, nas páginas em que outros plugins o ativam."

#. Author of the plugin
#: beltoft-scanner.php
msgid "beltoft.net"
msgstr ""

